{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|images/|fonts/|favicon|logo|apple-touch).*)",
      "destination": "/index.html"
    }
  ]
}
